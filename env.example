# =============================================================================
# POLYMARKET SPIKE BOT - CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to git!

# =============================================================================
# POLYMARKET CREDENTIALS (REQUIRED)
# =============================================================================

# Your Ethereum private key (64 hex characters, with or without 0x prefix)
# This is the private key of your Polymarket trading wallet
POLY_PRIVATE_KEY=your_64_character_hex_private_key_here

# Optional: API credentials for authenticated endpoints
# These are generated in Polymarket settings
# POLY_API_KEY=
# POLY_API_SECRET=
# POLY_API_PASSPHRASE=

# =============================================================================
# TRADING PARAMETERS
# =============================================================================

# Paper trading mode (TRUE = simulate trades, FALSE = real money)
# ALWAYS start with paper trading to test your configuration!
TRADING_PAPER_TRADING=true

# Spike detection threshold (percentage)
# Example: 3.0 = trigger signal when price moves 3% within the window
TRADING_SPIKE_THRESHOLD_PERCENT=3.0

# Spike detection window (seconds)
# Example: 2.0 = detect price movement within 2 seconds
TRADING_SPIKE_WINDOW_SECONDS=2.0

# Amount per trade in USDC
TRADING_ORDER_AMOUNT_USDC=10.0

# Limit order offset from current price (percentage)
# Example: 0.5 = place limit order 0.5% away from current price
TRADING_LIMIT_ORDER_OFFSET_PERCENT=0.5

# Take profit target (percentage)
TRADING_TAKE_PROFIT_PERCENT=2.0

# Target markets to monitor (comma-separated condition IDs)
# Leave empty to auto-discover active markets
TRADING_TARGET_MARKETS=

# =============================================================================
# RISK MANAGEMENT (CRITICAL!)
# =============================================================================

# Maximum percentage of portfolio per trade
RISK_MAX_PORTFOLIO_PERCENT=5.0

# Maximum concurrent open positions
RISK_MAX_OPEN_POSITIONS=3

# Hard stop loss percentage per position
RISK_STOP_LOSS_PERCENT=5.0

# Minimum seconds between trades on same market
RISK_COOLDOWN_SECONDS=30.0

# Maximum trades per hour (across all markets)
RISK_MAX_TRADES_PER_HOUR=10

# Daily loss limit in USDC (bot stops if this is hit)
RISK_DAILY_LOSS_LIMIT_USDC=100.0

# Volatility circuit breaker - pause if price moves X% in 1 minute
RISK_VOLATILITY_PAUSE_THRESHOLD=10.0

# Duration to pause after volatility trigger (seconds)
RISK_VOLATILITY_PAUSE_DURATION_SECONDS=300.0

# =============================================================================
# CONNECTION SETTINGS
# =============================================================================

# Environment: production or testnet
CONN_ENVIRONMENT=production

# Polymarket API endpoints (usually don't need to change)
CONN_CLOB_API_URL=https://clob.polymarket.com
CONN_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Retry configuration
CONN_MAX_RETRIES=5
CONN_RETRY_BASE_DELAY_SECONDS=1.0
CONN_RETRY_MAX_DELAY_SECONDS=60.0

# Timeouts
CONN_HTTP_TIMEOUT_SECONDS=30.0
CONN_WS_PING_INTERVAL_SECONDS=30.0
CONN_WS_RECONNECT_DELAY_SECONDS=5.0

# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=logs/bot.log

# Maximum log file size before rotation (bytes)
LOG_MAX_BYTES=10000000

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# Use JSON format for logs (useful for log aggregation)
LOG_JSON_FORMAT=false
